# Battery Health / Bypass Charging
r_dir_file(system_app, vendor_sysfs_usb_supply)
rw_dir_file(system_app, vendor_sysfs_battery_supply)

# LTPO Settings
rw_dir_file(system_app, vendor_sysfs_graphics)

# Gamespace
r_dir_file(system_app, vendor_sysfs_sde_crtc)

# Led / Vibrator
# /sys/class/leds only holds the class symlinks; the attribute files live under
# /sys/devices/... and carry sysfs_vibrator (see genfs_contexts). Platform
# policy reserves sysfs_leds:file for vendor domains (neverallow in
# system/sepolicy/private/coredomain.te), so keep this to directory listing and
# symlink traversal and let the sysfs_vibrator rules below do the I/O.
allow system_app sysfs_leds:dir r_dir_perms;
allow system_app sysfs_leds:lnk_file read;

# Touchpanel
rw_dir_file(system_app, vendor_proc_display)

# USB fast charge
rw_dir_file(system_app, vendor_sysfs_fastcharge)

# Vibrator
rw_dir_file(system_app, sysfs_vibrator)

# Zram
r_dir_file(system_app, sysfs_zram)

# OTG
allow system_app vendor_sysfs_usb_supply:file rw_file_perms;

# OPlusExtras
rw_dir_file(system_app, sysfs_dm)
rw_dir_file(system_app, sysfs_sync)
rw_dir_file(system_app, vendor_proc_wireless)
rw_dir_file(system_app, vendor_sysfs_graphics)
rw_dir_file(system_app, vendor_sysfs_kgsl)
rw_dir_file(system_app, vendor_sysfs_msm_perf)
allow system_app vendor_sysfs_msm_subsys:dir search;
allow system_app vendor_sysfs_sde_crtc:dir search;

hal_client_domain(system_app, hal_telephony)
binder_call(system_app, rild)
